{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flua, check current file",
      "type": "shell",
      "command": "flua",
      "args": [
        "--check",
        "${relativeFile}"
      ],
      "group": "build"
    },
    {
      "label": "flua, run current file (offline)",
      "type": "shell",
      "command": "flua",
      "args": [
        "--api",
        "local",
        "${relativeFile}"
      ],
      "group": "build"
    },
    {
      "label": "flua, export current file as .fqa",
      "type": "shell",
      "command": "flua",
      "args": [
        "export",
        "${relativeFile}",
        "-o",
        "${relativeFileDirname}/${relativeFileBasenameNoExtension}.fqa"
      ],
      "group": "build"
    }
  ]
}
