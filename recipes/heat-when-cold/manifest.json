{
  "id": "heat-when-cold",
  "title": "Heater on cold weather",
  "description": "Turns a heater on when the outside temperature drops below a threshold, off 1°C above it.",
  "categories": [
    "Climate"
  ],
  "simDevices": [
    "weatherMgr"
  ],
  "params": [
    {
      "name": "heaterId",
      "label": "Heater",
      "kind": "device",
      "filter": "com.fibaro.binarySwitch",
      "default": 0
    },
    {
      "name": "threshold",
      "label": "Start below (°C)",
      "kind": "number",
      "default": 10
    }
  ],
  "verify": {
    "params": {
      "heaterId": 1,
      "threshold": 10
    },
    "steps": [
      {
        "check": {
          "device": "heaterId",
          "value": false
        }
      },
      {
        "weather": {
          "Temperature": 5
        }
      },
      {
        "check": {
          "device": "heaterId",
          "value": true
        }
      },
      {
        "weather": {
          "Temperature": 15
        }
      },
      {
        "check": {
          "device": "heaterId",
          "value": false
        }
      }
    ]
  }
}
