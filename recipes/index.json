{
  "recipes": [
    {
      "id": "heat-when-cold",
      "title": "Heater on cold weather",
      "description": "Turns a heater on when the outside temperature drops below a threshold, off 1°C above it.",
      "categories": [
        "Climate"
      ],
      "simDevices": [
        "weatherMgr"
      ],
      "params": [
        {
          "name": "heaterId",
          "label": "Heater",
          "kind": "device",
          "filter": "com.fibaro.binarySwitch",
          "default": 0
        },
        {
          "name": "threshold",
          "label": "Start below (°C)",
          "kind": "number",
          "default": 10
        }
      ],
      "verify": {
        "params": {
          "heaterId": 1,
          "threshold": 10
        },
        "steps": [
          {
            "check": {
              "device": "heaterId",
              "value": false
            }
          },
          {
            "weather": {
              "Temperature": 5
            }
          },
          {
            "check": {
              "device": "heaterId",
              "value": true
            }
          },
          {
            "weather": {
              "Temperature": 15
            }
          },
          {
            "check": {
              "device": "heaterId",
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "humidity-fan",
      "title": "Fan on high humidity",
      "description": "Starts a fan above a humidity threshold, stops it 5% below (hysteresis).",
      "params": [
        {
          "name": "humidityId",
          "label": "Humidity sensor",
          "kind": "device",
          "filter": "com.fibaro.multilevelSensor",
          "default": 0
        },
        {
          "name": "fanId",
          "label": "Fan / switch",
          "kind": "device",
          "filter": "com.fibaro.binarySwitch",
          "default": 0
        },
        {
          "name": "threshold",
          "label": "Humidity % to start",
          "kind": "number",
          "default": 65
        }
      ],
      "categories": [
        "Climate"
      ],
      "verify": {
        "params": {
          "humidityId": 1,
          "fanId": 1,
          "threshold": 65
        },
        "steps": [
          {
            "check": {
              "device": "fanId",
              "value": false
            }
          },
          {
            "device": "humidityId",
            "call": "setValue",
            "args": [
              90
            ]
          },
          {
            "check": {
              "device": "fanId",
              "value": true
            }
          },
          {
            "slider": "thresholdSlider",
            "value": 95
          },
          {
            "check": {
              "device": "fanId",
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "leak-alert",
      "title": "Leak alert",
      "description": "Pushes a phone notification when a flood sensor detects water, optionally switches something on.",
      "params": [
        {
          "name": "floodId",
          "label": "Flood sensor",
          "kind": "device",
          "filter": "com.fibaro.binarySensor",
          "default": 0
        },
        {
          "name": "sirenId",
          "label": "Siren / switch (optional)",
          "kind": "device",
          "filter": "com.fibaro.binarySwitch",
          "default": 0
        }
      ],
      "categories": [
        "Alerts & alarms"
      ],
      "verify": {
        "params": {
          "floodId": 1,
          "sirenId": 1
        },
        "steps": [
          {
            "check": {
              "device": "sirenId",
              "value": false
            }
          },
          {
            "device": "floodId",
            "call": "breach"
          },
          {
            "check": {
              "device": "sirenId",
              "value": true
            }
          },
          {
            "check": {
              "log": "water detected"
            }
          },
          {
            "device": "floodId",
            "call": "clearBreach"
          },
          {
            "check": {
              "device": "sirenId",
              "value": false
            }
          },
          {
            "check": {
              "log": "water cleared"
            }
          }
        ]
      }
    },
    {
      "id": "light-at-sunset",
      "title": "Turn a light on at sunset",
      "description": "Switches a light on every day at sunset (adjustable by minutes).",
      "params": [
        {
          "name": "deviceId",
          "label": "Light",
          "kind": "device",
          "filter": "com.fibaro.binarySwitch",
          "default": 0
        },
        {
          "name": "offset",
          "label": "Minutes before sunset",
          "kind": "number",
          "default": -30
        }
      ],
      "categories": [
        "Lights"
      ],
      "verify": {
        "start": {
          "before": "sunset",
          "by": "2m"
        },
        "params": {
          "deviceId": 1,
          "offset": 1
        },
        "steps": [
          {
            "check": {
              "device": "deviceId",
              "value": false
            }
          },
          {
            "wait": "5m"
          },
          {
            "check": {
              "device": "deviceId",
              "value": true
            }
          }
        ]
      }
    },
    {
      "id": "motion-lights",
      "title": "Lights on motion",
      "description": "Turns a light on when a motion sensor sees movement, off after a delay.",
      "params": [
        {
          "name": "motionId",
          "label": "Motion sensor",
          "kind": "device",
          "filter": "com.fibaro.motionSensor",
          "default": 0
        },
        {
          "name": "lightId",
          "label": "Light",
          "kind": "device",
          "filter": "com.fibaro.binarySwitch",
          "default": 0
        },
        {
          "name": "minutes",
          "label": "On for (minutes)",
          "kind": "number",
          "default": 5
        }
      ],
      "categories": [
        "Lights",
        "Presence"
      ],
      "verify": {
        "params": {
          "motionId": 1,
          "lightId": 1,
          "minutes": 1
        },
        "steps": [
          {
            "check": {
              "device": "lightId",
              "value": false
            }
          },
          {
            "device": "motionId",
            "call": "breach"
          },
          {
            "check": {
              "device": "lightId",
              "value": true
            }
          },
          {
            "device": "motionId",
            "call": "clearBreach"
          },
          {
            "wait": "2m"
          },
          {
            "check": {
              "device": "lightId",
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "notify-when-door-opens",
      "title": "Notify when a door opens",
      "description": "Sends a phone push when a door sensor opens (re-arms when it closes).",
      "params": [
        {
          "name": "doorId",
          "label": "Door sensor",
          "kind": "device",
          "filter": "com.fibaro.doorSensor",
          "default": 0
        },
        {
          "name": "message",
          "label": "Message",
          "kind": "text",
          "default": "The door opened"
        }
      ],
      "categories": [
        "Doors & windows",
        "Alerts & alarms"
      ],
      "verify": {
        "params": {
          "doorId": 1
        },
        "steps": [
          {
            "device": "doorId",
            "call": "breach"
          },
          {
            "check": {
              "log": "push: The door opened"
            }
          },
          {
            "device": "doorId",
            "call": "clearBreach"
          },
          {
            "device": "doorId",
            "call": "breach"
          },
          {
            "check": {
              "log": "push: The door opened",
              "count": 2
            }
          }
        ]
      }
    }
  ]
}
