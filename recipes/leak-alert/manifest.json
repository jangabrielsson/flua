{
  "id": "leak-alert",
  "title": "Leak alert",
  "description": "Pushes a phone notification when a flood sensor detects water, optionally switches something on.",
  "params": [
    {
      "name": "floodId",
      "label": "Flood sensor",
      "kind": "device",
      "filter": "com.fibaro.binarySensor",
      "default": 0
    },
    {
      "name": "sirenId",
      "label": "Siren / switch (optional)",
      "kind": "device",
      "filter": "com.fibaro.binarySwitch",
      "default": 0
    }
  ],
  "categories": [
    "Alerts & alarms"
  ],
  "verify": {
    "params": {
      "floodId": 1,
      "sirenId": 1
    },
    "steps": [
      {
        "check": {
          "device": "sirenId",
          "value": false
        }
      },
      {
        "device": "floodId",
        "call": "breach"
      },
      {
        "check": {
          "device": "sirenId",
          "value": true
        }
      },
      {
        "check": {
          "log": "water detected"
        }
      },
      {
        "device": "floodId",
        "call": "clearBreach"
      },
      {
        "check": {
          "device": "sirenId",
          "value": false
        }
      },
      {
        "check": {
          "log": "water cleared"
        }
      }
    ]
  }
}
