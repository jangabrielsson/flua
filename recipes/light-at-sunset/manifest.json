{
  "id": "light-at-sunset",
  "title": "Turn a light on at sunset",
  "description": "Switches a light on every day at sunset (adjustable by minutes).",
  "params": [
    {
      "name": "deviceId",
      "label": "Light",
      "kind": "device",
      "filter": "com.fibaro.binarySwitch",
      "default": 0
    },
    {
      "name": "offset",
      "label": "Minutes before sunset",
      "kind": "number",
      "default": -30
    }
  ],
  "categories": [
    "Lights"
  ],
  "verify": {
    "start": {
      "before": "sunset",
      "by": "2m"
    },
    "params": {
      "deviceId": 1,
      "offset": 1
    },
    "steps": [
      {
        "check": {
          "device": "deviceId",
          "value": false
        }
      },
      {
        "wait": "5m"
      },
      {
        "check": {
          "device": "deviceId",
          "value": true
        }
      }
    ]
  }
}
