{
  "id": "humidity-fan",
  "title": "Fan on high humidity",
  "description": "Starts a fan above a humidity threshold, stops it 5% below (hysteresis).",
  "params": [
    {
      "name": "humidityId",
      "label": "Humidity sensor",
      "kind": "device",
      "filter": "com.fibaro.multilevelSensor",
      "default": 0
    },
    {
      "name": "fanId",
      "label": "Fan / switch",
      "kind": "device",
      "filter": "com.fibaro.binarySwitch",
      "default": 0
    },
    {
      "name": "threshold",
      "label": "Humidity % to start",
      "kind": "number",
      "default": 65
    }
  ],
  "categories": [
    "Climate"
  ],
  "verify": {
    "params": {
      "humidityId": 1,
      "fanId": 1,
      "threshold": 65
    },
    "steps": [
      {
        "check": {
          "device": "fanId",
          "value": false
        }
      },
      {
        "device": "humidityId",
        "call": "setValue",
        "args": [
          90
        ]
      },
      {
        "check": {
          "device": "fanId",
          "value": true
        }
      },
      {
        "slider": "thresholdSlider",
        "value": 95
      },
      {
        "check": {
          "device": "fanId",
          "value": false
        }
      }
    ]
  }
}
