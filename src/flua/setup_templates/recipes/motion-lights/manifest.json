{
  "id": "motion-lights",
  "title": "Lights on motion",
  "description": "Turns a light on when a motion sensor sees movement, off after a delay.",
  "params": [
    {
      "name": "motionId",
      "label": "Motion sensor",
      "kind": "device",
      "filter": "com.fibaro.motionSensor",
      "default": 0
    },
    {
      "name": "lightId",
      "label": "Light",
      "kind": "device",
      "filter": "com.fibaro.binarySwitch",
      "default": 0
    },
    {
      "name": "minutes",
      "label": "On for (minutes)",
      "kind": "number",
      "default": 5
    }
  ],
  "categories": [
    "Lights",
    "Presence"
  ],
  "verify": {
    "params": {
      "motionId": 1,
      "lightId": 1,
      "minutes": 1
    },
    "steps": [
      {
        "check": {
          "device": "lightId",
          "value": false
        }
      },
      {
        "device": "motionId",
        "call": "breach"
      },
      {
        "check": {
          "device": "lightId",
          "value": true
        }
      },
      {
        "device": "motionId",
        "call": "clearBreach"
      },
      {
        "wait": "2m"
      },
      {
        "check": {
          "device": "lightId",
          "value": false
        }
      }
    ]
  }
}
