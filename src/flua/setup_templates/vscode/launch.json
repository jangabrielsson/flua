{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flua: Run Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "flua",
      "args": ["--api", "local", "${relativeFile}"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Flua: Run Current File (Terminal)",
      "type": "debugpy",
      "request": "launch",
      "module": "flua",
      "args": ["--api", "local", "${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Flua: Run Current File (UI)",
      "type": "debugpy",
      "request": "launch",
      "module": "flua",
      "args": ["--api", "local", "--ui", "8090", "${relativeFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Flua: Debug Current File (mobdebug)",
      "type": "luaMobDebug",
      "request": "launch",
      "workingDirectory": "${workspaceFolder}",
      "sourceBasePath": "${workspaceFolder}",
      "listenPort": 8172,
      "stopOnEntry": false,
      "sourceEncoding": "UTF-8",
      "interpreter": "flua",
      "arguments": [
        "--api", "local",
        "${relativeFile}"
      ],
      "listenPublicly": true
    },
    {
      "name": "Flua: Debug Current File (UI+mobdebug)",
      "type": "luaMobDebug",
      "request": "launch",
      "workingDirectory": "${workspaceFolder}",
      "sourceBasePath": "${workspaceFolder}",
      "listenPort": 8172,
      "stopOnEntry": false,
      "sourceEncoding": "UTF-8",
      "interpreter": "flua",
      "arguments": [
        "--api", "local", "--ui", "8090",
        "${relativeFile}"
      ],
      "listenPublicly": true
    }
  ]
}
